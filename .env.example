# ============================================================
# VYAPAAR-MITRA — environment configuration
# Copy to .env and fill in. Never commit the real .env.
# ============================================================

# ---------------- App ----------------
APP_NAME=Vyapaar-Mitra
APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
DEMO_MODE=false
RUN_BOT=true
ENABLE_SCHEDULER=true

# ---------------- Web frontend ----------------
WEB_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WEB_DIST_DIR=

# ---------------- MongoDB ----------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=vyapaar_mitra

# ---------------- Matching ----------------
MATCH_RADIUS_METERS=500
MAX_MATCH_RADIUS_METERS=5000
RADIUS_EXPANSION_STEPS=500,1000,2000,5000
MAX_MERCHANTS_PER_REQUEST=8
MERCHANT_COOLDOWN_HOURS=12
REQUEST_EXPIRY_MINUTES=30

# Multi-offer comparison
OFFER_WINDOW_SECONDS=20

# Trust & freshness
TRUST_MIN_SAMPLE=5
TRUST_RESPONSE_TIME_FAST_SEC=60
TRUST_RESPONSE_TIME_OK_SEC=300

# Stock opportunity scoring
OPPORTUNITY_MIN_REQUESTS=3
OPPORTUNITY_RADIUS_METERS=3000

# Demand heatmap privacy
HEATMAP_BUCKET_METERS=300

# Ranking weights (should add up to 1.0)
WEIGHT_CATEGORY=0.30
WEIGHT_CAPABILITY=0.35
WEIGHT_DISTANCE=0.20
WEIGHT_HISTORY=0.15

CONFIDENCE_DIRECT=0.80
CONFIDENCE_UNCERTAIN=0.60

# Search radius presets
SEARCH_RADIUS_DEFAULT_METERS=5000
SEARCH_RADIUS_MIN_METERS=1000
SEARCH_RADIUS_MAX_METERS=20000
SEARCH_RADIUS_PRESETS_METERS=1000,2000,5000,10000,20000

# ---------------- Security ----------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-in-production
AUTH_TOKEN_TTL_MINUTES=10
SESSION_TTL_HOURS=72
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
AI_RATE_LIMIT=20
AI_RATE_WINDOW_SECONDS=60
COOKIE_SECURE=false

# Phone OTP
OTP_STUB_MODE=false
OTP_TTL_MINUTES=5
OTP_LENGTH=6
SMS_GATEWAY=twilio

# Shopfront photo verification
SHOPFRONT_PHOTO_DISTANCE_METERS=200
SHOPFRONT_PHOTO_MAX_BYTES=5242880
SHOPFRONT_PHOTO_DIR=

# Customer safety
PANIC_SMS_STUB=false

# ---------------- AI provider chain ----------------
# Fallback chain: PRIMARY -> FALLBACK -> TERTIARY
PRIMARY_LLM_PROVIDER=gemini
FALLBACK_LLM_PROVIDER=groq
TERTIARY_LLM_PROVIDER=gpt_oss

GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GPT_OSS_MODEL=openai/gpt-oss-20b
GPT_OSS_BASE_URL=https://api.groq.com/openai/v1
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v4
SARVAM_LANGUAGE=hi-IN
AI_TIMEOUT_SECONDS=45

# Product images
PRODUCT_IMAGE_SEARCH_SUFFIX=product india

# ---------------- Email (optional) ----------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
ENABLE_SCHEDULED_REPORTS=false
DEMAND_REPORT_HOUR=20

# ---------------- Email verification ----------------
# Link-based email verification — single-use, hashed-at-rest, 24h TTL tokens.
# Tokens are sha256-hashed and stored in the email_verification_tokens
# collection. The raw token only ever appears in the verification email link.
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
# If true, login is blocked until the user has clicked their verification link.
# Defaults to false for the hackathon demo (no SMTP friction needed to demo).
# Flip to true in production for real security.
EMAIL_VERIFICATION_REQUIRED=false
# The frontend app's base URL — verification links point here, not the
# backend. Leave blank to fall back to PUBLIC_BASE_URL (the monolith
# deployment, where the FastAPI app serves the React build at /).
# Example: https://app.vyapaar-mitra.com
WEB_APP_BASE_URL=

# ---------------- Pro subscription (Shopkeeper SaaS, ₹299/month) ----------------
# Pro unlocks the 6 analytics benefits on the merchant Pro Dashboard:
# nearby hot products, demand heatmap, sales analytics, smart pricing,
# slow-mover alerts, festival readiness.
# For the hackathon demo, /merchant/subscribe grants a free 14-day trial
# with no real payment. In production, this is wired to Razorpay.
PRO_SUBSCRIPTION_PRICE_PAISE=29900
PRO_SUBSCRIPTION_DURATION_DAYS=30
PRO_TRIAL_DURATION_DAYS=14
# Slow-mover alert: flag an inventory item if it hasn't been restocked in
# this many days AND demand for the same product is up by the ratio below.
PRO_SLOW_MOVER_THRESHOLD_DAYS=14
PRO_SLOW_MOVER_DEMAND_RATIO_THRESHOLD=1.30
# Festival readiness: how many days ahead of an upcoming festival to
# start surfacing stock-up recommendations. 21 days = 3 weeks prep.
PRO_FESTIVAL_LOOKAHEAD_DAYS=21

# ---------------- Demo seeding ----------------
SEED_CENTER_LAT=24.0734
SEED_CENTER_LNG=75.0686
SEED_PASSWORD=VyapaarDemo123

# ============================================================
# API KEYS — paste your keys below
# ============================================================

# --- Telegram (free from @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
ADMIN_TELEGRAM_IDS=

# --- Google Gemini (free at https://aistudio.google.com/app/apikey) ---
GEMINI_API_KEY=

# --- Groq (free at https://console.groq.com) ---
GROQ_API_KEY=

# --- GPT-OSS (optional, reuse Groq key or self-host) ---
GPT_OSS_API_KEY=

# --- Sarvam AI (for voice search — https://www.sarvam.ai) ---
SARVAM_API_KEY=

# --- Twilio (for real OTP + panic SMS — https://www.twilio.com/try-twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Twilio Verify (PREFERRED for India — DLT-compliant, Twilio manages OTP
# generation + validation + rate limiting + 10-min expiry, supports SMS +
# WhatsApp + voice channels). When set AND SMS_GATEWAY=twilio, send_otp/
# verify_otp use the Verify API instead of the basic SMS API.
# 200 verifications/month FREE on the Starter plan.
# Create a Verify Service at: Twilio Console → Verify → Services → Create new
# Leave blank to use the basic SMS path via TWILIO_FROM_NUMBER instead.
TWILIO_VERIFY_SERVICE_SID=

# --- ImgBB (for shopfront photo hosting — https://imgbb.com/api) ---
IMGBB_API_KEY=

# --- Razorpay (for in-app payments — https://dashboard.razorpay.com/app/keys) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Pexels (OPTIONAL — for product images — https://www.pexels.com/api/)
# NOTE: Pexels key issuance is currently paused. Without this key, the
# system falls back to Openverse (no key needed) + Lorem Picsum placeholder.
# Leave blank — the system works without it.
PEXELS_API_KEY=
