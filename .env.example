# ============================================================
# VYAPAAR-MITRA — environment configuration
# Copy to .env and fill in. Never commit the real .env.
# ============================================================

# ---------------- App ----------------
APP_HOST=0.0.0.0
APP_PORT=8000
# Public URL used to build the one-time Telegram login links.
# For local demos use an ngrok/cloudflared HTTPS URL so the link opens on phones.
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
DEMO_MODE=true
RUN_BOT=false
# Set true only in a dedicated persistent process that should own Telegram polling.
ENABLE_SCHEDULER=false

# ---------------- Telegram ----------------
TELEGRAM_BOT_TOKEN=
# Bot username without @ — needed for the web app's "Connect Telegram" deep link
TELEGRAM_BOT_USERNAME=
# Comma-separated Telegram numeric user ids that may run /admin
ADMIN_TELEGRAM_IDS=

# ---------------- Web frontend (React app in web/) ----------------
# Origins allowed to call /api/v1 with cookies (the Vite dev server by default)
WEB_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Leave empty to auto-detect web/dist. When it exists, FastAPI serves the app at /
WEB_DIST_DIR=

# ---------------- MongoDB ----------------
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net
# For a cloud deployment, ALWAYS set MONGODB_URI in the hosting provider's environment variables.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=vyapaar_mitra

# ---------------- AI providers ----------------
# Fallback chain: PRIMARY -> FALLBACK -> TERTIARY
PRIMARY_LLM_PROVIDER=gemini
FALLBACK_LLM_PROVIDER=groq
TERTIARY_LLM_PROVIDER=gpt_oss

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# GROQ = inference provider (NOT Grok, the xAI model)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# GPT-OSS open-weight models via any OpenAI-compatible endpoint
# (Groq, vLLM, Ollama, LM Studio). Use gpt-oss-120b where supported.
GPT_OSS_API_KEY=
GPT_OSS_MODEL=openai/gpt-oss-20b
GPT_OSS_BASE_URL=https://api.groq.com/openai/v1

# Sarvam AI — Indian-language speech to text
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_LANGUAGE=hi-IN

AI_TIMEOUT_SECONDS=45

# ---------------- Matching ----------------
MATCH_RADIUS_METERS=500
MAX_MATCH_RADIUS_METERS=5000
RADIUS_EXPANSION_STEPS=500,1000,2000,5000
MAX_MERCHANTS_PER_REQUEST=8
MERCHANT_COOLDOWN_HOURS=12
REQUEST_EXPIRY_MINUTES=30
OFFER_WINDOW_SECONDS=90

# Ranking weights (should add up to 1.0)
WEIGHT_CATEGORY=0.30
WEIGHT_CAPABILITY=0.35
WEIGHT_DISTANCE=0.20
WEIGHT_HISTORY=0.15

CONFIDENCE_DIRECT=0.80
CONFIDENCE_UNCERTAIN=0.60

# ---------------- Security ----------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-in-production
AUTH_TOKEN_TTL_MINUTES=10
SESSION_TTL_HOURS=72
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
AI_RATE_LIMIT=20
AI_RATE_WINDOW_SECONDS=60
# Set true when serving over HTTPS
COOKIE_SECURE=false

# ---------------- Email (optional) ----------------
# Leave blank to run without email. Telegram keeps working either way.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
ENABLE_SCHEDULED_REPORTS=false
DEMAND_REPORT_HOUR=20

# ---------------- Demo seeding ----------------
SEED_CENTER_LAT=24.0734
SEED_CENTER_LNG=75.0686
SEED_PASSWORD=VyapaarDemo123
